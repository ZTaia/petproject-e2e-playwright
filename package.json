{
  "name": "technicalinterview-e2e-playwright",
  "version": "1.0.0",
  "description": "Playwright end-to-end test for the OrangeHRM system-user lifecycle",
  "scripts": {
    "test": "playwright test",
    "test:negative": "playwright test --grep @negative",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZTaia/technicalinterview-e2e-playwright.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ZTaia/technicalinterview-e2e-playwright/issues"
  },
  "homepage": "https://github.com/ZTaia/technicalinterview-e2e-playwright#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
